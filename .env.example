# Copy these into Render > your web service > Environment.
# Never commit real values to GitHub and never paste secrets into chat.
TWITCH_CLIENT_ID=replace_with_your_twitch_client_id
TWITCH_CLIENT_SECRET=replace_with_your_twitch_client_secret

# The public Render URL, with no trailing slash, for example:
# https://clemsupp-moderation-dashboard.onrender.com
APP_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com

# PostgreSQL connection string from the Render Postgres database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Make these with the commands in README.md. Keep them private.
ADMIN_PASSWORD=replace_with_a_long_private_password
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_characters
EVENTSUB_SECRET=replace_with_a_random_secret_at_least_32_characters

NODE_ENV=production
